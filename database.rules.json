{
  "rules": {
    ".read": false,
    ".write": false,
    "reservations": {
      "$shop": {
        ".read": "auth != null && (root.child('users_to_shops').child(auth.uid).val() === $shop || auth.uid === 'cGhWqj5Mtiey6AC8CMpiUZDxAGh1')",
        "$bookingId": {
          ".write": "auth != null && (root.child('users_to_shops').child(auth.uid).val() === $shop || auth.uid === 'cGhWqj5Mtiey6AC8CMpiUZDxAGh1')",
          ".validate": "!newData.exists() || (newData.hasChildren(['name', 'phone', 'email', 'date', 'time', 'guests', 'timestamp', 'cancelToken', 'status']) && root.child('shop_details').child($shop).exists() && root.child('shop_details').child($shop).child('status').val() !== 'pending' && root.child('shop_details').child($shop).child('status').val() !== 'closed' && (!root.child('shop_details').child($shop).child('paidUntil').exists() || root.child('shop_details').child($shop).child('paidUntil').val() > now))",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "time": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "guests": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 5)"
          },
          "location": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "occasion": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "comments": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "cancelToken": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "source": {
            ".validate": "newData.isString() && newData.val().matches(/^(google|site|social|direct|phone|walkin)$/)"
          },
          "lang": {
            ".validate": "newData.isString() && newData.val().matches(/^(el|en)$/)"
          },
          "createdBy": {
            ".validate": "newData.isString() && newData.val() === 'admin'"
          },
          "attendance": {
            ".validate": "newData.isString() && newData.val().matches(/^(arrived|noshow)$/)"
          },
          "reminderSentAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        ".indexOn": [
          "date"
        ]
      }
    },
    "users_to_shops": {
      ".read": "auth != null && auth.uid === 'cGhWqj5Mtiey6AC8CMpiUZDxAGh1'",
      ".write": "auth != null && auth.uid === 'cGhWqj5Mtiey6AC8CMpiUZDxAGh1'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "shop_details": {
      ".read": "auth != null && auth.uid === 'cGhWqj5Mtiey6AC8CMpiUZDxAGh1'",
      ".write": "auth != null && auth.uid === 'cGhWqj5Mtiey6AC8CMpiUZDxAGh1'",
      "$shop": {
        ".read": "auth != null && (root.child('users_to_shops').child(auth.uid).val() === $shop || auth.uid === 'cGhWqj5Mtiey6AC8CMpiUZDxAGh1')",
        "displayName": {
          ".read": true
        },
        "status": {
          ".read": true
        },
        "paidUntil": {
          ".read": true
        },
        "openHour": {
          ".read": true
        },
        "closeHour": {
          ".read": true
        },
        "maxGuests": {
          ".read": true
        }
      }
    },
    "shop_profile": {
      "$shop": {
        ".read": "auth != null && (root.child('users_to_shops').child(auth.uid).val() === $shop || auth.uid === 'cGhWqj5Mtiey6AC8CMpiUZDxAGh1')",
        ".write": "auth != null && (root.child('users_to_shops').child(auth.uid).val() === $shop || auth.uid === 'cGhWqj5Mtiey6AC8CMpiUZDxAGh1')",
        "coverPhoto": {
          ".read": true
        },
        "gallery": {
          ".read": true
        },
        "logoPhoto": {
          ".read": true
        },
        "info": {
          "$field": {
            ".read": "$field !== 'notificationEmail'"
          }
        }
      }
    },
    "guests": {
      "$shop": {
        ".read": "auth != null && (root.child('users_to_shops').child(auth.uid).val() === $shop || auth.uid === 'cGhWqj5Mtiey6AC8CMpiUZDxAGh1')",
        ".write": "auth != null && (root.child('users_to_shops').child(auth.uid).val() === $shop || auth.uid === 'cGhWqj5Mtiey6AC8CMpiUZDxAGh1')",
        "$guest": {
          ".validate": "$guest.matches(/^[0-9]{6,15}$/) && newData.hasChildren(['notes', 'updatedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "notes": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "tags": {
            "$tag": {
              ".validate": "newData.isBoolean() && $tag.matches(/^(vip|allergy|outdoor|attention)$/)"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
